{
  "name": "timber/teak",
  "type": "library",
  "description": "Generate a Markdown reference documentation for PHP projects (optimized for WordPress)",
  "license": "MIT",
  "authors": [
    {
      "name": "Lukas Gaechter",
      "email": "lukas.gaechter@mind.ch",
      "homepage": "https://www.mind.ch"
    }
  ],
  "require": {
    "php": ">=8.3.0",
    "phpdocumentor/reflection": "^7.0",
    "phpdocumentor/reflection-docblock": "^6.0",
    "symfony/console": "^7",
    "symfony/filesystem": "^7"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "Teak\\": "lib",
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "rector": "vendor/bin/rector process",
    "rector:dry-run": "vendor/bin/rector process --dry-run"
  },
  "bin": [
    "teak"
  ]
}
